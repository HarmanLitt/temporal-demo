{
  "name": "quickbite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker,status,web \"npm:service:order-api\" \"npm:service:worker\" \"npm:service:status\" \"npm:dev:web\"",
    "dev:api": "npm run service:order-api",
    "dev:web": "vite",
    "service:order-api": "tsx services/order-api/index.ts",
    "service:worker": "tsx services/worker/index.ts",
    "service:status": "tsx services/order-status-service/index.ts",
    "start:api": "npm run service:order-api",
    "temporal:up": "docker compose up -d postgresql temporal temporal-ui",
    "temporal:down": "docker compose down",
    "services:up": "docker compose up -d --build order-api worker order-status-service",
    "services:stop": "docker compose stop order-api worker order-status-service",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@temporalio/activity": "1.9.3",
    "@temporalio/client": "1.9.3",
    "@temporalio/worker": "1.9.3",
    "@temporalio/workflow": "1.9.3",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
